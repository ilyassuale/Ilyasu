# App
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=["*"]

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_ai
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector DB
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=interview-ai-jobs

# Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=interview-ai
S3_REGION=us-east-1
USE_MINIO=true

# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
WHISPER_MODEL=base
SPACY_MODEL=en_core_web_md
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@interview-ai.example.com

# Frontend
FRONTEND_URL=http://localhost:3000
